# 로컬/dev 실행용 예시 값. 실제 값은 절대 커밋하지 않는다.
# prod는 SSM Parameter Store(SecureString)에서 배포 시 주입한다 (CLAUDE.md §13.7).

SPRING_PROFILES_ACTIVE=local

# --- Database ---
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/fdt_local?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=fdt_app
SPRING_DATASOURCE_PASSWORD=change-me

# --- Kakao OAuth2 (Phase 3에서 사용 시작) ---
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# --- Signup policy (CLAUDE.md §3.2) ---
SIGNUP_POLICY=OPEN
SIGNUP_LOCAL_LOGIN=false

# --- S3 / CloudFront (Phase 1 이미지 파이프라인에서 사용 시작) ---
AWS_S3_BUCKET=
AWS_S3_REGION=ap-northeast-2
AWS_CLOUDFRONT_DOMAIN=

# --- 배포 (backend.yml이 EC2의 .env에 이 값을 채워 넣는다, CLAUDE.md §13.6) ---
# 로컬에서는 비워두면 docker-compose.yml의 기본값(finedining-backend:local)을 쓴다.
BACKEND_IMAGE=
